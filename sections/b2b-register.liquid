{{ 'b2b.css' | asset_url | stylesheet_tag }}
<div class="page-width section-{{ section.id }}-padding">
  <div class="b2b-register">
    <h1 class="title">{% if page.title != blank %}{{ page.title }}{% else %}{{ 'b2b.reg.title' | t }}{% endif %}</h1>
    <div class="rte b2b-register__intro">{% if page.content != blank %}{{ page.content }}{% else %}<p>{{ 'b2b.reg.intro' | t }}</p>{% endif %}</div>
    {%- form 'contact', id: 'B2BRegisterForm' -%}
      <input type="hidden" name="contact[Typ zgłoszenia]" value="Rejestracja firmy B2B">
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status-list form__message" role="status">{{ 'b2b.reg.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<div class="b2b-register__error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><input class="field__input" id="b2b-nip" name="contact[NIP]" required inputmode="numeric" placeholder="{{ 'b2b.reg.nip' | t }}" data-nip><label class="field__label" for="b2b-nip">{{ 'b2b.reg.nip' | t }}</label></div>
        <p class="b2b-register__hint">{{ 'b2b.reg.nip_hint' | t }}</p>
        <p class="b2b-register__error" data-nip-error hidden>{{ 'b2b.reg.nip_error' | t }}</p>
        <div class="field"><input class="field__input" id="b2b-company" name="contact[Firma]" required autocomplete="organization" placeholder="{{ 'b2b.reg.company' | t }}"><label class="field__label" for="b2b-company">{{ 'b2b.reg.company' | t }}</label></div>
        <div class="field"><input class="field__input" id="b2b-address" name="contact[Adres]" required autocomplete="street-address" placeholder="{{ 'b2b.reg.address' | t }}"><label class="field__label" for="b2b-address">{{ 'b2b.reg.address' | t }}</label></div>
        <div class="field"><input class="field__input" id="b2b-delivery" name="contact[Adres dostawy]" autocomplete="shipping street-address" placeholder="{{ 'b2b.reg.delivery' | t }}"><label class="field__label" for="b2b-delivery">{{ 'b2b.reg.delivery' | t }}</label></div>
        <div class="b2b-register__grid">
          <div class="field"><input class="field__input" id="b2b-person" name="contact[Osoba kontaktowa]" required autocomplete="name" placeholder="{{ 'b2b.reg.person' | t }}"><label class="field__label" for="b2b-person">{{ 'b2b.reg.person' | t }}</label></div>
          <div class="field"><input class="field__input" id="b2b-phone" name="contact[Telefon]" required autocomplete="tel" placeholder="{{ 'b2b.reg.phone' | t }}"><label class="field__label" for="b2b-phone">{{ 'b2b.reg.phone' | t }}</label></div>
        </div>
        <div class="field"><input class="field__input" id="b2b-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'b2b.reg.email' | t }}"><label class="field__label" for="b2b-email">{{ 'b2b.reg.email' | t }}</label></div>
        <div class="select">
          <select class="select__select" id="b2b-type" name="contact[Rodzaj działalności]" aria-label="{{ 'b2b.reg.type' | t }}">
            <option>{{ 'b2b.reg.type_shop' | t }}</option><option>{{ 'b2b.reg.type_online' | t }}</option><option>{{ 'b2b.reg.type_wholesale' | t }}</option><option>{{ 'b2b.reg.type_chain' | t }}</option><option value="{{ 'b2b.reg.type_other' | t }}" data-other>{{ 'b2b.reg.type_other' | t }}</option>
          </select>
          <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
        </div>
        {%- comment -%} 07.10.2026 (Adrian): przy „Inne” opis, gdzie klient sprzedaje; przewidywane ilości zamówień {%- endcomment -%}
        <div class="field" data-other-field hidden><textarea class="text-area field__input" id="b2b-other" name="contact[Opis działalności]" rows="3" placeholder="{{ 'b2b.reg.other_details' | t }}"></textarea><label class="field__label" for="b2b-other">{{ 'b2b.reg.other_details' | t }}</label></div>
        <div class="field"><input class="field__input" id="b2b-volume" name="contact[Przewidywane ilości zamówień]" placeholder="{{ 'b2b.reg.volume' | t }}"><label class="field__label" for="b2b-volume">{{ 'b2b.reg.volume' | t }}</label></div>
        <p class="b2b-register__hint">{{ 'b2b.reg.volume_hint' | t }}</p>
        <label class="b2b-register__consent"><input type="checkbox" required><span>{{ 'b2b.reg.terms_html' | t: terms_url: shop.terms_of_service.url, privacy_url: shop.privacy_policy.url }}</span></label>
        <button type="submit" class="button button--primary">{{ 'b2b.reg.submit' | t }}</button>
      {%- endif -%}
    {%- endform -%}
    <p style="margin-top:2rem">{{ 'b2b.reg.have_account' | t }} <a class="link" href="{{ routes.account_login_url }}">{{ 'b2b.login' | t }}</a></p>
  </div>
</div>
<script>
  (function(){var f=document.getElementById('B2BRegisterForm');if(!f)return;var sel=f.querySelector('#b2b-type'),box=f.querySelector('[data-other-field]'),ta=box&&box.querySelector('textarea');function tog(){var on=sel&&sel.selectedOptions[0]&&sel.selectedOptions[0].hasAttribute('data-other');if(box){box.hidden=!on;ta.required=!!on;}}if(sel){sel.addEventListener('change',tog);tog();}})();
  (function(){var f=document.getElementById('B2BRegisterForm');if(!f)return;f.addEventListener('submit',function(e){var i=f.querySelector('[data-nip]');if(!i)return;var n=i.value.replace(/\D/g,'');if(n.length!==10)return;var w=[6,5,7,2,3,4,5,6,7],s=0;for(var k=0;k<9;k++)s+=w[k]*+n[k];if(s%11!==+n[9]){e.preventDefault();var er=f.querySelector('[data-nip-error]');if(er)er.hidden=false;i.focus();}});})();
</script>
{%- style -%}
  .section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top | times: 0.75 | round: 0 }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px}
  @media screen and (min-width:750px){.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}
{%- endstyle -%}
{% schema %}
{
  "name": "Rejestracja firmy (B2B)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ],
  "presets": [ { "name": "Rejestracja firmy (B2B)" } ]
}
{% endschema %}
