{%- liquid
  assign b2b_access = true
  if settings.b2b_hide_prices
    if customer == nil
      assign b2b_access = false
    elsif settings.b2b_require_company and customer.b2b? != true
      assign b2b_access = false
    endif
  endif
-%}
{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate{% if b2b_access %} section-{{ section.id }}-padding{% endif %}">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks">
        {% for block in section.blocks %}
          {%- if b2b_access == false -%}{%- continue -%}{%- endif -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }}>
                {% render 'b2b-cart-totals' %}
                {%- comment -%}
                  01.11.2026: minimum (2000 zł, 2 szt. na kolor) w .js-contents, bo cart.js po zmianie ilości odświeża tylko ten fragment —
                  wcześniej komunikat i zablokowany przycisk zostawały w starym stanie do przeładowania strony. Znacznik data-b2b-below
                  czyta skrypt na dole sekcji i blokuje „Realizuj zakup”.
                {%- endcomment -%}
                {% render 'b2b-cart-minimum' %}
                {%- capture below_min -%}{% render 'b2b-cart-minimum', check: true %}{%- endcapture -%}
                {%- if below_min == '1' -%}<span data-b2b-below hidden></span>{%- endif -%}

              </div>
            {%- else -%}
              {%- capture below_min -%}{% render 'b2b-cart-minimum', check: true %}{%- endcapture -%}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  {% if cart == empty or below_min == '1' %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {{ 'sections.cart.checkout' | t }}
                  <span class="b2b-sum__arrow" aria-hidden="true">→</span>
                </button>
              </div>
              <ul class="b2b-sum__trust list-unstyled" role="list">
                <li><span class="svg-wrapper">{{ 'icon-padlock.svg' | inline_asset_content }}</span>{{ 'b2b.cart.secure' | t }}</li>
                <li><span class="svg-wrapper">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>{{ 'b2b.cart.invoice' | t }}</li>
              </ul>

              {%- if additional_checkout_buttons -%}
                <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var footer = document.getElementById('main-cart-footer');
    if (!footer) return;
    var sync = function () {
      var btn = document.getElementById('checkout');
      if (btn) btn.disabled = !!footer.querySelector('[data-b2b-below]') || !document.querySelector('.cart-item');
    };
    new MutationObserver(sync).observe(footer, { childList: true, subtree: true });
    document.addEventListener('submit', function (e) {
      if (e.submitter && e.submitter.name === 'checkout' && footer.querySelector('[data-b2b-below]')) e.preventDefault();
    }, true);
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },    
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
